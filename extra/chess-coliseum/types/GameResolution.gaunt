module Tristan.Community.ChessColiseum.Type;

obj GameResolution is Enum {

    meta {
        let String NormalName = "Game Resolution";
        let Int32 Id = 1003;
        let Array[String, 3] NormalFieldNames = Array[String, 3].new(
            "No Contest",
            "Draw",
            "Decisive"
        );
    }

    fields {
        let UInt64 value = 0;
        let UInt64 NoContest = 0;
        let UInt64 Draw = 1;
        let UInt64 Decisive = 2;
    }

    functions {

        fn new(UInt64 ordinal) -> GameResolution {
            this.value = ordinal;
            return this;
        }

    }

}